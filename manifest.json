{
  "user": [
    { "source": "templates/user/commands/blog.md",
      "target": "~/.agents/commands/blog.md",
      "mode": "whole" },
    { "source": "templates/user/commands/블로그.md",
      "target": "~/.agents/commands/블로그.md",
      "mode": "whole" },
    { "source": "templates/user/skills/writing-tistory-blog",
      "target": "~/.agents/skills/writing-tistory-blog",
      "mode": "whole",
      "recursive": true }
  ],
  "project": [
    { "source": "templates/project/AGENTS.md",
      "target": "./AGENTS.md",
      "mode": "markers" },
    { "source": "templates/project/PLAN.md",
      "target": "./PLAN.md",
      "mode": "init-only",
      "substitute": { "{{PROJECT_NAME}}": "basename(cwd)" } },
    { "source": "templates/project/.agents/skills/cnp",
      "target": "./.agents/skills/cnp",
      "mode": "whole",
      "recursive": true },
    { "source": "templates/project/.agents/skills/audit",
      "target": "./.agents/skills/audit",
      "mode": "whole",
      "recursive": true }
  ]
}
